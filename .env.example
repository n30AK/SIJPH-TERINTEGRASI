# Copy to local .env.local or configure in the hosting provider. Never commit real credentials.
DATABASE_URL=
# Random secret, at least 32 characters. Server-side only; never expose as NEXT_PUBLIC_*.
SIJPH_ADMIN_API_KEY=
# Keep intake disabled until privacy/legal review, rate limiting and anti-abuse controls are approved.
PUBLIC_INTAKE_ENABLED=false
DATA_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_NOTICE_VERSION=2026-10-20-v1
# AI Companion: OpenAI-compatible Chat Completions API. Secrets must remain server-side.
AI_PROVIDER=openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Set to the public origin after deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
